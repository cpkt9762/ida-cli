+            return
+        elif stage == "Acquired":
+            self.handles.append(value)
+            self.attempts[-1].update(stage=stage, handle=value, failure_kind=None, obligation="exact_handle")
+        elif stage == "AttachFailed":
+            self.attempts[-1].update(value)
