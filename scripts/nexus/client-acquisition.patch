+            cause = error.attach_error
+        if isinstance(cause, (AcquiredFailure, StageObserverFailure)):
+            cause = cause.cause
+        unknown = [attempt for attempt in self.attempts if attempt["obligation"] == "unknown_attach"]
+        failure = None if error is None else ("cleanup_required" if handle is not None else
+            self.attempts[-1]["failure_kind"] if self.attempts else
+            "startup_unconfirmed" if self.launches else "not_sent")
