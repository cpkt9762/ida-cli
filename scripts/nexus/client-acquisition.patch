+            self.reconnect |= stage == "ReconnectResolved"
+        elif stage == "BeforeAttach":
+            self.attempts.append({"attempt": len(self.attempts) + 1,
+                "instance": value, "stage": stage, "failure_kind": "not_sent",
+                "cause": None, "handle": None, "obligation": None, "http_status": None})
