+    @classmethod
+    def attach_outcome(
+        cls, instance: DatabaseInstance, *, path: str | None = None,
+        keepalive: float = 0.0, idle_timeout: float | None = None,
+        recovery: DatabaseRecovery = "none",
+        on_disconnect: Callable[[DatabaseHandle, str], None] | None = None,
+        on_acquired: Callable[[DatabaseHandle], None] | None = None,
+        on_stage: AcquisitionObserver | None = None,
+    ) -> AcquisitionOutcome:
+        """One attach, never re-resolve/retry. Callbacks run inline without locks.
+
+        Exceptions become raw cause/secondary errors; a returned handle is the
+        exact resource, even when callbacks or monitor setup failed. Explicit
+        claim/close ends SDK retention, not any earlier unknown obligation.
+        """
+        ledger = _Acquisition(on_stage)
+        ledger.stage = "BeforeAttach"
+        ledger.instances.append(instance)
+        def acquired(handle: DatabaseHandle) -> None:
+            if on_acquired is not None:
+                on_acquired(handle)
+        try:
+            handle = cls.attach(instance, path=path, keepalive=keepalive,
+                idle_timeout=idle_timeout, recovery=recovery, on_disconnect=on_disconnect,
+                on_acquired=acquired, on_stage=ledger.observe)
+        except Exception as error:
+            return ledger.outcome(None, error)
+        return ledger.outcome(handle, None)
+
+    @classmethod
+    def open_outcome(
+        cls, path: str, *, options: DatabaseOpenOptions | None = None,
+        observer: AcquisitionObserver | None = None,
+        on_acquired: Callable[[DatabaseHandle], None] | None = None,
+        on_disconnect: Callable[[DatabaseHandle, str], None] | None = None,
+    ) -> AcquisitionOutcome:
+        """Legacy at-most-two resolve/attach attempts plus an obligation ledger.
+
+        Both options.acquisition_observer and observer run (options first).
+        Any observer failure aborts acquisition without a transport retry.
+        No post-exit re-resolve or durable custody is implemented by this API.
+        """
+        from dataclasses import replace
+        options = options or DatabaseOpenOptions()
+        def observe(stage: AcquisitionStage, value: Any) -> None:
+            _notify_stage(options.acquisition_observer, stage, value)
